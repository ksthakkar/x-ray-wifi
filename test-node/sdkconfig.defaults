CONFIG_ESP_WIFI_CSI_ENABLED=y

# Streaming CSI at ~50 Hz exhausts the default 32 dynamic TX buffers, which
# surfaces as sendto() failing with errno 12 (ENOMEM). Doubling the pool plus
# the extra lwIP mboxes below keeps the send path from starving.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# Promiscuous CSI capture delivers a lot of frames; a larger RX pool avoids
# dropping them before the callback runs.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
