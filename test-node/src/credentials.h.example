// Copy this file to credentials.h and fill in your own values.
// credentials.h is gitignored and will never be committed.

#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Where the ESP32 sends CSI/UDP packets (e.g. the UNO Q's LAN IP).
#define CSI_TARGET_IP "192.168.1.100"
#define CSI_TARGET_PORT 5005

// Unique per physical node -- set a different value (1, 2, 3, ...) in each
// node's credentials.h so the viewer can tell their streams apart.
#define CSI_NODE_ID 1
