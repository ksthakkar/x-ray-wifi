// Copy this file to credentials.h and fill in your own values.
// credentials.h is gitignored and will never be committed.

#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Where the ESP32 sends CSI/UDP packets (e.g. your laptop's LAN IP).
#define CSI_TARGET_IP "192.168.1.100"
#define CSI_TARGET_PORT 5005

// Node ID, stamped into every CSI packet. MUST be unique per board when
// several nodes stream to one recorder: the recorder separates streams by this
// value, and duplicates would merge two boards' data into one.
#define CSI_NODE_ID 1
